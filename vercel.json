{
  "buildCommand": "pnpm --filter @workspace/swiftmatch build",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "public",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://swiftmatch-api.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
